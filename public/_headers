# ProofRoom response headers.
#
# Origin-Agent-Cluster keeps this origin in its own agent cluster.
# Permissions-Policy is deliberately not used to restrict `tools`, because a
# restrictive tools policy disables WebMCP tool registration for this page.

/*
  Origin-Agent-Cluster: ?1
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=3600
