{
  "name": "proofroom-webmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "ProofRoom, an agent-native B2B evaluation room built on WebMCP",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/check-no-em-dash.mjs && node scripts/check-readme-parity.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "capture:visual:evidence": "UPDATE_VISUAL_AUDIT=1 playwright test tests/e2e/evaluationVisual.spec.ts --project=e2e",
    "capture:visual:decision": "UPDATE_VISUAL_AUDIT=1 playwright test tests/e2e/decisionVisual.spec.ts --project=e2e",
    "capture:visual:recovery": "UPDATE_VISUAL_AUDIT=1 playwright test tests/e2e/recoveryVisual.spec.ts --project=e2e",
    "test:a11y": "playwright test --project=accessibility",
    "evals": "node --experimental-strip-types evals/run.mjs",
    "evals:live:validate": "node --experimental-strip-types evals/live-agent/validate.ts",
    "evals:responses:test": "node --experimental-strip-types --test evals/responses-api/tests/responsesApi.test.ts",
    "evals:responses:dry": "node --experimental-strip-types evals/responses-api/dry.ts",
    "evals:responses:validate": "node --experimental-strip-types evals/responses-api/validate.ts",
    "evals:responses": "node --experimental-strip-types evals/responses-api/run.ts",
    "check:bundle": "node --experimental-strip-types scripts/check-bundle.ts",
    "bundle:check": "npm run check:bundle",
    "qa": "node --experimental-strip-types scripts/qa.ts",
    "qa:receipt": "node --experimental-strip-types scripts/qa.ts --write-receipt",
    "release:rc:refresh": "node --experimental-strip-types scripts/rc-gate.ts refresh",
    "release:rc:validate": "node --experimental-strip-types scripts/rc-gate.ts validate",
    "release:rc:gate": "node --experimental-strip-types scripts/rc-gate.ts gate",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "verify:public": "node --experimental-strip-types scripts/verify-public.ts",
    "test:public": "playwright test --config=playwright.public.config.ts",
    "verify:webmcp:chrome": "node --experimental-strip-types scripts/verify-webmcp-chrome.ts",
    "release:receipt:validate": "node --experimental-strip-types scripts/release-receipt.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/black-ops-one": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wrangler": "4.126.0"
  }
}
